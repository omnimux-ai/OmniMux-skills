{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Video Storyboard Output",
  "description": "用于描述视频分镜主输出的结构化 schema，适用于电商短视频、UGC 演示、产品展示等场景。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "summary",
    "structure",
    "shots"
  ],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "platform",
        "format",
        "duration_seconds"
      ],
      "properties": {
        "title": {
          "type": "string",
          "description": "项目标题"
        },
        "platform": {
          "type": "string",
          "description": "目标平台"
        },
        "format": {
          "type": "string",
          "description": "画幅格式，例如 9:16"
        },
        "duration_seconds": {
          "type": "number",
          "description": "总时长（秒）",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "description": "输出语言"
        },
        "video_type": {
          "type": "string",
          "description": "视频类型，例如 ecommerce_conversion / ugc_demo / product_showcase"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "target_audience",
        "core_selling_points"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "description": "视频目标"
        },
        "target_audience": {
          "type": "string",
          "description": "目标受众描述"
        },
        "core_selling_points": {
          "type": "array",
          "description": "核心卖点",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cta": {
          "type": "string",
          "description": "CTA 文案或目标动作"
        },
        "creative_strategy": {
          "type": "string",
          "description": "表达策略概述"
        }
      }
    },
    "structure": {
      "type": "array",
      "description": "视频结构分段总览",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "section",
          "start_time",
          "end_time",
          "goal",
          "content"
        ],
        "properties": {
          "section": {
            "type": "string",
            "description": "分段名称，例如 Hook / 痛点 / 卖点演示 / CTA"
          },
          "start_time": {
            "type": "number",
            "description": "分段开始时间"
          },
          "end_time": {
            "type": "number",
            "description": "分段结束时间"
          },
          "goal": {
            "type": "string",
            "description": "该分段承担的任务"
          },
          "content": {
            "type": "string",
            "description": "该分段内容概述"
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "description": "逐镜头分镜内容",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/shot"
      }
    },
    "rhythm_notes": {
      "type": "array",
      "description": "节奏建议",
      "items": {
        "type": "string"
      }
    },
    "production_notes": {
      "type": "array",
      "description": "全局执行备注",
      "items": {
        "type": "string"
      }
    },
    "compliance_notes": {
      "type": "array",
      "description": "合规提醒或风险说明",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "start_time",
        "end_time",
        "duration",
        "scene_purpose",
        "visual_description"
      ],
      "properties": {
        "shot_id": {
          "type": "string",
          "description": "镜头编号，例如 01 / 02 / S01",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "description": "所属结构分段，例如 Hook / 痛点 / 卖点演示 / CTA"
        },
        "start_time": {
          "type": "number",
          "description": "镜头开始时间（秒）",
          "minimum": 0
        },
        "end_time": {
          "type": "number",
          "description": "镜头结束时间（秒）",
          "minimum": 0
        },
        "duration": {
          "type": "number",
          "description": "镜头时长（秒）",
          "exclusiveMinimum": 0
        },
        "scene_purpose": {
          "type": "string",
          "description": "该镜头承担的主要任务，例如 抓住注意力 / 展示操作简单 / 引导点击",
          "minLength": 1
        },
        "visual_description": {
          "type": "string",
          "description": "镜头中的画面说明，要求可视化、可执行",
          "minLength": 1
        },
        "framing": {
          "type": "string",
          "description": "景别，例如 特写 / 近景 / 中景 / 中近景 / 产品特写"
        },
        "camera_movement": {
          "type": "string",
          "description": "运镜方式，例如 轻推 / 横移 / 跟拍 / 定镜 / 快切"
        },
        "camera_angle": {
          "type": "string",
          "description": "机位角度，例如 平视 / 俯拍 / 仰拍 / 自拍角度 / 桌面俯视"
        },
        "lens_feel": {
          "type": "string",
          "description": "镜头感觉，例如 手持感 / 稳定器感 / 自拍感 / 微距感"
        },
        "subject": {
          "type": "string",
          "description": "镜头主体，例如 年轻女性 / 产品 / 手部动作 / 产品与成品饮品"
        },
        "subject_action": {
          "type": "string",
          "description": "主体动作描述"
        },
        "environment": {
          "type": "string",
          "description": "场景环境说明，例如 厨房台面 / 办公桌面 / 健身房外"
        },
        "props": {
          "type": "array",
          "description": "道具列表",
          "items": {
            "type": "string"
          }
        },
        "wardrobe": {
          "type": "string",
          "description": "服装建议或角色造型说明"
        },
        "expression_emotion": {
          "type": "string",
          "description": "表情/情绪，例如 略急 / 满意 / 轻松推荐感"
        },
        "dialogue_vo": {
          "type": "string",
          "description": "口播、旁白或对镜表达"
        },
        "on_screen_text": {
          "type": "string",
          "description": "字幕文案"
        },
        "selling_point": {
          "type": "string",
          "description": "该镜头主要承接的卖点"
        },
        "user_pain_point": {
          "type": "string",
          "description": "该镜头对应的用户痛点"
        },
        "transition": {
          "type": "string",
          "description": "与前后镜头的衔接方式，例如 硬切 / 动作连切 / 定格收尾 / match cut"
        },
        "audio_notes": {
          "type": "string",
          "description": "音频备注，例如 BGM 节奏、环境声、点击音效等"
        },
        "lighting": {
          "type": "string",
          "description": "光线描述，例如 自然晨光 / 柔和室内光 / 高对比轮廓光"
        },
        "composition_notes": {
          "type": "string",
          "description": "构图建议，例如 主体居中 / 预留字幕区 / 产品位于中下部"
        },
        "continuity_notes": {
          "type": "string",
          "description": "连续性说明，例如 保持产品颜色一致 / 与上一镜头同一服装"
        },
        "production_notes": {
          "type": "string",
          "description": "执行备注，给拍摄、AI 出图或剪辑使用"
        },
        "prompt_hint": {
          "type": "string",
          "description": "简化提示词，用于快速转成 AI 生成 prompt"
        },
        "risk_notes": {
          "type": "string",
          "description": "风险提醒，如表达可能过度、动作不清晰、合规风险等"
        }
      }
    }
  }
}
