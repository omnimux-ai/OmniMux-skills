{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A+图片提示词输出",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global_direction",
    "prompts"
  ],
  "properties": {
    "global_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_consistency",
        "product_consistency",
        "render_quality",
        "negative_prompt"
      ],
      "properties": {
        "style_consistency": {
          "type": "string",
          "description": "整套A+图片统一风格要求"
        },
        "product_consistency": {
          "type": "string",
          "description": "商品一致性要求"
        },
        "render_quality": {
          "type": "string",
          "description": "渲染质量要求"
        },
        "negative_prompt": {
          "type": "string",
          "description": "全局负面提示词"
        },
        "compliance_guardrails": {
          "type": "array",
          "description": "合规护栏",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "module_id",
          "module_type",
          "goal",
          "prompt"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "description": "对应规划中的模块ID"
          },
          "module_type": {
            "type": "string",
            "enum": [
              "hero_banner",
              "brand_story",
              "feature_highlights",
              "comparison_chart",
              "how_to_use",
              "specifications",
              "lifestyle_scene",
              "materials_detail",
              "faq",
              "closing_banner"
            ]
          },
          "goal": {
            "type": "string",
            "description": "该张图片的目标"
          },
          "prompt": {
            "type": "string",
            "description": "最终可用于生成的完整提示词"
          },
          "negative_prompt": {
            "type": "string",
            "description": "局部负面提示词"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": ["1:1", "4:5", "16:9", "3:4", "auto"]
          },
          "text_overlay": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "headline": {
                "type": "string"
              },
              "subheadline": {
                "type": "string"
              },
              "body_points": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "placement_notes": {
                "type": "string"
              }
            }
          },
          "asset_dependencies": {
            "type": "array",
            "description": "依赖素材",
            "items": {
              "type": "string"
            }
          },
          "quality_checks": {
            "type": "array",
            "description": "出图验收点",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
