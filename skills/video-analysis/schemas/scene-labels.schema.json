{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video-analysis-scene-labels.schema.json",
  "description": "Gxgen 视频分析片段标签枚举",
  "type": "object",
  "properties": {
    "allowed_labels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "hook",
          "intro",
          "problem",
          "demo_scene",
          "feature_highlight",
          "benefit_highlight",
          "social_proof",
          "objection_handling",
          "offer",
          "cta",
          "outro",
          "unknown"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    }
  },
  "required": [
    "allowed_labels"
  ],
  "additionalProperties": false
}
